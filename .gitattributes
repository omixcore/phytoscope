# Normalize line endings to avoid meaningless cross-platform diffs
* text=auto eol=lf

# Keep Windows batch scripts as CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep shell scripts as LF
mvnw text eol=lf
*.sh text eol=lf

# Do not convert line endings in binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.zip binary
