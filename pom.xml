<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>io.gitee.omixcore</groupId>
    <artifactId>phytoscope</artifactId>
    <version>0.1.0</version>
    <name>PhytoScope</name>
    <description>
        Species-agnostic plant genome structure browser (JavaFX desktop, Java 21).
        Reads GFF3/GTF from any organism, overlays expression heat-map tracks,
        and ships a four-species example panel plus a headless batch renderer.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <dependencies>
        <!-- Service layer: Spring Boot (dependency injection, extensible data services) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JavaFX desktop UI -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- SwingFXUtils, used to write canvas snapshots to PNG -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Explicit main class: the project intentionally has two entry
                        points (the GUI launcher and the headless batch renderer), so
                        Spring Boot cannot guess which one to wire into the fat jar.
                        PhytoScopeLauncher dispatches to either mode at runtime.
                    -->
                    <mainClass>io.gitee.omixcore.phytoscope.PhytoScopeLauncher</mainClass>
                </configuration>
            </plugin>

            <!-- JavaFX run plugin: mvn javafx:run starts the desktop interface -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.gitee.omixcore.phytoscope.PhytoScopeLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
